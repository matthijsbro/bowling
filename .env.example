# Copy to .env next to docker-compose.yml and fill in what you need. Everything is optional.

# Mail for login codes. Without SMTP_HOST the codes are printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# On by default, because the server runs behind Caddy, which tells it each player's real address.
# Set to 0 if the server ever faces the internet directly: otherwise anyone can pick their own
# address and slip past the per-address limits below.
TRUST_PROXY=1

# Limits. These are the defaults; 0 switches a limit off.
TEAMS_PER_HOUR_PER_IP=10
TEAMS_PER_HOUR=300
MAX_TEAMS=5000
JOINS_PER_MINUTE_PER_IP=30
ACCOUNTS_PER_DAY_PER_IP=5
ACCOUNTS_PER_DAY=200
MAX_ACCOUNTS=10000
CODES_PER_10_MIN_PER_IP=10
CODES_PER_10_MIN_PER_ADDRESS=3
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_IP=20
# game messages (votes, throws, joining) per open game connection; not mail
MESSAGES_PER_10_SECONDS=100
